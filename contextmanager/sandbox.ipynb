   "metadata": {},
   "outputs": [],
   "source": [
    "from contextlib import contextmanager\n",
    "\n",
    "@contextmanager\n",
    "def logged(label):\n",
    "    print(f\"enter {label}\")\n",
    "    yield\n",
    "    print(f\"exit {label}\")\n",
    "\n",
    "@logged(\"reading\")\n",
    "def read_lines():\n",
    "    yield \"first\"\n",
    "    yield \"second\"\n",
    "\n",
    "for line in read_lines():\n",
    "    print(line)"
   ]
  }
 ],
